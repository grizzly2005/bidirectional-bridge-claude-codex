{
  "name": "bidirectional-bridge",
  "private": true,
  "version": "0.3.1",
  "description": "Experimental MCP coordination bridge for bounded bidirectional delegation between Claude Code and OpenAI Codex",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grizzly2005/bidirectional-bridge-claude-codex.git"
  },
  "bugs": {
    "url": "https://github.com/grizzly2005/bidirectional-bridge-claude-codex/issues"
  },
  "homepage": "https://github.com/grizzly2005/bidirectional-bridge-claude-codex#readme",
  "type": "module",
  "bin": {
    "claude-codex-bridge": "./scripts/native-bridge-mcp.mjs",
    "bridge-tracking-mcp": "./scripts/bridge-tracking-mcp.mjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "shared/*",
    "claude/*",
    "codex/*"
  ],
  "scripts": {
    "build": "tsc --build && node scripts/build-tracking-ui.mjs",
    "typecheck": "tsc --build --force",
    "clean": "tsc --build --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:tracking-ui": "node scripts/test-tracking-ui.mjs",
    "test:tracking-permissions": "node scripts/test-tracking-permissions.mjs",
    "benchmark:tracking": "node scripts/benchmark-tracking.mjs",
    "skills:check": "node scripts/sync-bridge-skill.mjs --check",
    "skills:sync": "node scripts/sync-bridge-skill.mjs --write",
    "links:check": "node scripts/repair-workspace-links.mjs",
    "links:fix": "node scripts/repair-workspace-links.mjs --fix",
    "live:claude": "node claude/claude-side/scripts/live-claude-delegation.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "esbuild": "0.28.2",
    "playwright": "1.63.0",
    "typescript": "^7.0.2",
    "vitest": "5.0.3"
  },
  "overrides": {
    "vite": "6.4.3"
  }
}
