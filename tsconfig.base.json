{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": false,
    "types": ["node"],

    "baseUrl": ".",
    // Resolve workspace packages by path rather than through node_modules symlinks.
    // npm workspace symlinks are unreliable on Windows without developer mode and on
    // network/FUSE mounts, and one broken link turns every cross-package import into a
    // compile error. Project references still drive build order; these paths only tell
    // the resolver where each package lives, so both agents get a working build either way.
    // NOTE: every key here must be a real compiler option — TypeScript rejects unknown
    // properties inside compilerOptions even when they look like comments (TS5025).
    "paths": {
      "@bridge/protocol": ["./shared/protocol/src/index.ts"],
      "@bridge/control-plane": ["./shared/control-plane/src/index.ts"],
      "@bridge/mcp-server-core": ["./shared/mcp-server-core/src/index.ts"],
      "@bridge/claude-side": ["./claude/claude-side/src/index.ts"],
      "@bridge/codex-side": ["./codex/codex-side/src/index.ts"]
    }
  }
}
