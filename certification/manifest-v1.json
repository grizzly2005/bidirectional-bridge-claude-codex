{
  "version": 1,
  "description": "Exact project-material manifest for the bridge v0.2.0 experimental checkpoint.",
  "hash_definition": {
    "algorithm": "sha256",
    "domain_separator": "bridge-certification-manifest-v1",
    "path_order": "ascending bytewise UTF-8 order",
    "record_encoding": "uint32be(path_utf8_length) || path_utf8 || uint64be(content_length) || raw_content",
    "content_policy": "regular UTF-8 files with LF line endings; NUL and CRLF are rejected"
  },
  "explicit_runtime_database_fixtures": [],
  "exclusion_rules": [
    {
      "pattern": "(^|/)\\.git(/|$)",
      "reason": "Git internals"
    },
    {
      "pattern": "(^|/)(node_modules|dist|build|coverage)(/|$)",
      "reason": "dependencies and generated build or coverage output"
    },
    {
      "pattern": "(^|/)\\.bridge(/|$)",
      "reason": "local control-plane runtime state"
    },
    {
      "pattern": "(^|/)(tmp|temp|scratch)(/|$)",
      "reason": "temporary workspaces and scratch material"
    },
    {
      "pattern": "(^|/)\\.walprobe\\.db(?:-(?:journal|wal|shm))?$",
      "reason": "local SQLite capability-probe database and sidecars"
    },
    {
      "pattern": "(^|/)vitest\\.config\\.ts\\.timestamp-[^/]+\\.mjs$",
      "reason": "generated Vitest timestamp configuration modules"
    },
    {
      "pattern": "\\.(?:db|db-journal|db-wal|db-shm|log|tmp|temp|tgz|tsbuildinfo)$",
      "reason": "runtime databases, journals, logs, temporary files, packages, and compiler state"
    },
    {
      "pattern": "(^|/)(?:\\.env(?:\\.[^/]*)?|credentials?(?:/|$)|secrets?(?:/|$)|id_rsa)$",
      "reason": "credential or secret material"
    },
    {
      "pattern": "\\.(?:pem|key|pfx|p12|keystore)$",
      "reason": "private key or credential container"
    },
    {
      "pattern": "(^|/)\\.DS_Store$",
      "reason": "operating-system metadata"
    }
  ],
